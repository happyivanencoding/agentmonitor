{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Monitor",
  "version": "0.5.6",
  "identifier": "com.agentmonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Monitor",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#101217",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "shortDescription": "Know what your agents are doing.",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "startMenuFolder": "Agent Monitor"
      }
    },
    "resources": {
      "../extension/": "extension/",
      "../dist/": "web/",
      "../agentdock-skill/execution-progress/": "execution-progress-skill/"
    }
  }
}
